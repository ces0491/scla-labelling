# Copy to .env.local and fill in. Never commit .env.local.

# ---------------------------------------------------------------------------
# Supabase -- labellers / tasks / labels DB
# ---------------------------------------------------------------------------

# Project URL, e.g. https://abcdefgh.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Service-role key (NOT the anon key). The app talks to Supabase
# from the Next.js server only, never from the browser, so the
# service-role key is the right credential. RLS is NOT enabled --
# tenancy is enforced at the API-route layer because every query
# scopes by session.labeller_id.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Cloudflare R2 -- frame storage
# ---------------------------------------------------------------------------

# R2 access key id + secret. Token must have read+write on the
# `labelling/` prefix only (or a dedicated bucket).
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Bucket name and the S3-style endpoint. Reuse scla-dev with a
# `labelling/` prefix is the simplest path; a dedicated bucket is
# cleaner if labelling volumes grow.
R2_BUCKET=scla-dev
R2_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com

# Key prefix inside the bucket. Frames live at
# <R2_FRAME_PREFIX>/<match_id>/<frame_idx>-<nonce>.jpg
R2_FRAME_PREFIX=labelling

# How long each signed frame URL lives. 24h is enough for a
# labelling session; raise if labellers report frames expiring
# mid-session.
R2_FRAME_TTL_SECONDS=86400

# ---------------------------------------------------------------------------
# Resend -- magic-link email
# ---------------------------------------------------------------------------

RESEND_API_KEY=
RESEND_FROM_EMAIL=labelling@scla.sheetsolved.com

# ---------------------------------------------------------------------------
# App config
# ---------------------------------------------------------------------------

# Where the app is hosted -- used in magic-link callback URLs.
# Local: http://localhost:3000
# Production: https://labelling.scla.sheetsolved.com (or your Vercel domain)
APP_BASE_URL=http://localhost:3000

# Random hex string for signing session cookies. Generate:
#   node -e "console.log(crypto.randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Shared secret the SCLA push_labelling_tasks.py script uses to
# create tasks. Generate the same way as SESSION_SECRET.
ADMIN_API_KEY=
